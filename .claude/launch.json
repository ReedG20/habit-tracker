{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "metro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client"
      ],
      "port": 8081
    },
    {
      "name": "metro-tunnel",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client",
        "--tunnel"
      ],
      "port": 8081
    }
  ]
}
