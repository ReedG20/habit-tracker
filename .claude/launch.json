{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "metro",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "exec bunx expo start --dev-client --port ${PORT:-8081}"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "metro-tunnel",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "exec bunx expo start --dev-client --tunnel --port ${PORT:-8081}"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
