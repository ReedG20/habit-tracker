# Copy to .env.local (gitignored). `bunx convex dev` writes the Convex lines
# itself; the rest come from the Clerk, Google Cloud and Stripe dashboards.
#
# EXPO_PUBLIC_* values are inlined into the JS bundle at build time, so each
# EAS environment (development / preview / production) carries its own set:
#   bunx eas-cli@latest env:create --environment production --name EXPO_PUBLIC_CONVEX_URL --value ...
# Server-side secrets (STRIPE_SECRET_KEY, OPENROUTER_API_KEY, CLERK_JWT_ISSUER_DOMAIN,
# STRIPE_WEBHOOK_SECRET) live on the Convex deployment: see convex/convex.config.ts.

# Convex — written by `bunx convex dev`
CONVEX_DEPLOYMENT=dev:<name>
EXPO_PUBLIC_CONVEX_URL=https://<name>.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://<name>.convex.site

# Clerk — API keys page. pk_test_ for dev, pk_live_ for production.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Google Sign-In — OAuth clients in Google Cloud, registered with Clerk.
# Needed at BUILD time too (a config plugin reads them), not only at runtime.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=<id>.apps.googleusercontent.com
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=<id>.apps.googleusercontent.com
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.<id>

# Stripe — publishable key. pk_test_ for dev, pk_live_ for production.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
