<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/sims-clean.sh hourly from the main checkout. Install:
     cp scripts/com.useanteapp.sims-clean.plist ~/Library/LaunchAgents/
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.useanteapp.sims-clean.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.useanteapp.sims-clean</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>echo "== $(date)"; /Users/reedgrenager/Projects/habit-tracker/scripts/sims-clean.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/opt/anaconda3/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/reedgrenager/Library/Logs/ante-sims-clean.log</string>
  <key>StandardErrorPath</key><string>/Users/reedgrenager/Library/Logs/ante-sims-clean.log</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
